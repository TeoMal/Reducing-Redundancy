core.[0-9]*

# Superseded pre-rewrite code, kept locally for reference only.
# These are the notebooks and script published at commit a170f3a; they remain in
# git history and can be recovered with:
#   git show a170f3a:cifar10.py
# Their results are NOT comparable to the current code, which fixes a double
# softmax, the ImageNet-stem ResNet on 32x32 inputs, and missing normalisation.
legacy/

